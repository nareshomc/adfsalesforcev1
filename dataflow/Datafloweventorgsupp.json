				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> AttributeTypessupport",
				"filter1 select(mapColumn(",
				"          TABLEENTRIESID,",
				"          LONGDESCRIPTION,",
				"          DATECHANGED",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selecttableentriesorganised",
				"eventattributes select(mapColumn(",
				"          ParentID = PARENTID,",
				"          TABLEENTRIESID,",
				"          ATTRIBUTETYPESID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join6, selecttableentriesorganised join(select1@TABLEENTRIESID == selecttableentriesorganised@TABLEENTRIESID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ParentID,",
				"          OrganisedBy = LONGDESCRIPTION,",
				"          DATECHANGED",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"filter6 derive(OrganisedBy = case(",
				"    in( ['Community - East of England',",
				"'Community - London & SE',",
				"'Community - Midlands',",
				"'Community - North of England',",
				"'Community - Northern Ireland',",
				"'Community - Scotland',",
				"'Community - South West, Wales, CI'",
				"], OrganisedBy), 'Supporter Relationships Team', ",
				"    in(['Corporate Comms',",
				"'Corporate New Business',",
				"'Corporate Partnerships',",
				"'Corporate Regional'],OrganisedBy), 'Corporate', ",
				"",
				" in(['Pents - 3rd Party',",
				"'Pents - DIY',",
				"'Pents - Owned Events',",
				"'Pents - Owned Products'],OrganisedBy), 'Mass Participation Team', ",
				" in(['Engagement and Stewardship'],OrganisedBy), 'Engagement and Stewardship Team', ",
				" in(['Legacies'],OrganisedBy), 'Legacies Team', ",
				" in(['Major Supporters'],OrganisedBy), 'Philanthropy Team', ",
				" in(['Volunteer Partnerships','Special Events' ],OrganisedBy), 'Volunteer Board Fundraising Team', ",
				"",
				"    ''",
				")) ~> derivedColumn1",
