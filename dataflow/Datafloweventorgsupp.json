				"          SupportedBy",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"selectsupp derive(SupportedBy = case(",
				"    in( ['Community - East of England',",
				"'Community - London & SE',",
				"'Community - Midlands',",
				"'Community - North of England',",
				"'Community - Northern Ireland',",
				"'Community - Scotland',",
				"'Community - South West, Wales, CI'], SupportedBy), 'Supporter Led Fundraising', ",
				"    in(['Corporate Comms',",
				"'Corporate New Business',",
				"'Corporate Partnerships',",
				"'Corporate Regional'],SupportedBy), 'Corporate', ",
				"",
				" in(['Pents - 3rd Party',",
				"'Pents - DIY',",
				"'Pents - Owned Events',",
				"'Pents - Owned Products'],SupportedBy), 'Mass Participation', ",
				" in(['Engagement and Stewardship'],SupportedBy), 'Engagement and Stewardship', ",
