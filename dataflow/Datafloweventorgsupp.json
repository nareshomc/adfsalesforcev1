{
	"name": "Datafloweventorgsupp",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "specialevents"
				},
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "tableentries"
				},
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "eventattributes"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "selecttableentries"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CAPACITY as integer,",
				"          DATE_ADDED as timestamp,",
				"          DATE_LAST_CHANGED as timestamp,",
				"          DESCRIPTION as string,",
				"          END_DATE as timestamp,",
				"          END_TIME as timestamp,",
				"          GOAL as decimal(20,4),",
				"          GROUPID as integer,",
				"          ID as integer,",
				"          IMPORT_ID as string,",
				"          NAME as string,",
				"          NUM_INVITED as integer,",
				"          START_DATE as timestamp,",
				"          START_TIME as timestamp,",
				"          TYPEID as integer,",
				"          CATEGORY as integer,",
				"          INACTIVE as short,",
				"          DISPLAYONCALENDAR as short,",
				"          EVENTID as string,",
				"          ADDEDBYID as integer,",
				"          LASTCHANGEDBYID as integer,",
				"          ClassFrequency as short,",
				"          NumClasses as short,",
				"          ClassStartDate as timestamp,",
				"          ClassEndDate as timestamp,",
				"          ClassStartTime as timestamp,",
				"          ClassEndTime as timestamp,",
				"          ClassMonth as short,",
				"          ClassDayOfMonth1 as short,",
				"          ClassDayOfWeek as short,",
				"          ClassSpacing as short,",
				"          ClassFreqSubType as short,",
				"          ClassWeek as short,",
				"          ClassWeekDays as short,",
				"          LocationName as string,",
				"          LocationCountry as integer,",
				"          LocationAddress as string,",
				"          LocationCity as string,",
				"          LocationState as string,",
				"          LocationPostCode as string,",
				"          LocationPhone as string,",
				"          LocationContact as string,",
				"          LocationNotes as string,",
				"          LocationCounty as integer,",
				"          LocationNZCity as integer,",
				"          LocationNZSuburb as integer,",
				"          LocationSuburb as integer,",
				"          ItineraryDesc as string,",
				"          SeatingBasis as short,",
				"          SeatingNumSections as integer,",
				"          SeatingNumTables as integer,",
				"          SeatingNumSeats as integer,",
				"          SeatingCapacity as integer,",
				"          AnnotationText as string,",
				"          AnnotationAutoDisplay as short,",
				"          ClassDayOfMonth2 as short,",
				"          ClassDayType1 as short,",
				"          ClassDayType2 as short,",
				"          GiftDefaultsID as integer,",
				"          DefaultReceiptAmtType as short,",
				"          DefaultReceiptAmtValue as decimal(19,4),",
				"          CAMPAIGN_ID as integer,",
				"          TCode_TE_ID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> specialevents",
				"source(output(",
				"          TABLEENTRIESID as integer,",
				"          ACTIVE as short,",
				"          LONGDESCRIPTION as string,",
				"          SHORTDESCRIPTION as string,",
				"          SYSTEMENTRY as short,",
				"          PHONETYPE as short,",
				"          PHONEFORMAT as short,",
				"          SEQUENCE as integer,",
				"          CODETABLESID as integer,",
				"          DATEADDED as timestamp,",
				"          DATECHANGED as timestamp,",
				"          ADDEDBYID as integer,",
				"          LASTCHANGEDBYID as integer,",
				"          NUMERICVALUE as decimal(20,4),",
				"          AWARDAMOUNT as integer,",
				"          AWARDAMTUNITS as short,",
				"          MerchantNumber as string,",
				"          ADDED_BY_ID as integer,",
				"          LAST_CHANGED_BY_ID as integer,",
				"          UKSPECIFIC as short,",
				"          MEMSPECIFIC as short,",
				"          TableNumber as integer,",
				"          RatingsDataType as short,",
				"          PHONETYPENOTSHAREABLE as short,",
				"          INTEGRATION_ID as integer,",
				"          INTEGRATION_DATE_LAST_CHANGED as timestamp,",
				"          PGSpecific as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> tableentries",
				"source(output(",
				"          ATTRIBUTESID as integer,",
				"          ATTRIBUTETYPESID as integer,",
				"          TEXT as string,",
				"          NUM as integer,",
				"          DATETIME as timestamp,",
				"          CURRENCY as decimal(19,4),",
				"          BOOLEAN as short,",
				"          COMMENTS as string,",
				"          SEQUENCE as short,",
				"          TABLEENTRIESID as integer,",
				"          ATTRIBUTEDATE as timestamp,",
				"          PARENTID as integer,",
				"          IMPORTID as string,",
				"          ConstitID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> eventattributes",
				"tableentries select(mapColumn(",
				"          TABLEENTRIESID,",
				"          LONGDESCRIPTION",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selecttableentries"
			]
		}
	}
}