				"          RECORDTYPE as short,",
				"          DESCRIPTION as string,",
				"          TYPEOFDATA as short,",
				"          CODETABLESID as integer,",
				"          REQUIRED as short,",
				"          IMPORTID as string,",
				"          SystemMask as integer,",
				"          MUSTBEUNIQUE as short,",
				"          SEQUENCE as integer,",
				"          PRODUCTFLAG as integer,",
				"          COUNTRYMASK as integer,",
