				"          ID,",
				"          NAME,",
				"          EVENTID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"tableentries filter(in ([2276,",
				"13673,",
				"17386,",
				"13580,",
				"17882,",
				"13676,",
				"13671,",
				"23025,",
				"13678,",
				"13679,",
				"20390,",
				"23027,",
				"23026,",
				"20389,",
				"18066,",
				"17881,",
				"23028,",
				"19989,",
				"22644,",
				"20619,",
				"17875,",
				"22661,",
