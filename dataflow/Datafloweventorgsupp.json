				"          TABLEENTRIESID,",
				"          LONGDESCRIPTION",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selecttableentriesorganised",
				"eventattributes select(mapColumn(",
				"          ParentID = PARENTID,",
				"          TABLEENTRIESID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, selecttableentriesorganised join(select1@TABLEENTRIESID == selecttableentriesorganised@TABLEENTRIESID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ParentID,",
				"          OrganisedBy = LONGDESCRIPTION",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 derive(OrganisedBy = case(",
				"    in( ['Community - East of England',",
				"'Community - London & SE',",
				"'Community - Midlands',",
				"'Community - North of England',",
				"'Community - Northern Ireland',",
				"'Community - Scotland',",
				"'Community - South West, Wales, CI',",
				"'Community Fundraising'], OrganisedBy), 'Supporter Led Fundraising', ",
				"    in(['Corporate Comms',",
				"'Corporate New Business',",
				"'Corporate Partnerships',",
				"'Corporate Regional'],OrganisedBy), 'Corporate', ",
				"",
				" in(['Pents - 3rd Party',",
				"'Pents - DIY',",
				"'Pents - Owned Events',",
				"'Pents - Owned Products'],OrganisedBy), 'Mass Participation', ",
				" in(['Engagement and Stewardship'],OrganisedBy), 'Engagement and Stewardship', ",
				" in(['Legacies'],OrganisedBy), 'Legacies', ",
				" in(['Major Supporters'],OrganisedBy), 'Major Donors', ",
				" in(['Special Events'],OrganisedBy), 'Special Events', ",
				" in(['Volunteer Partnerships'],OrganisedBy), 'Volunteer Board Fundraising', ",
				"",
				"    'None'",
				")) ~> derivedColumn1",
				"specialevents select(mapColumn(",
				"          ID,",
				"          NAME,",
				"          EVENTID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"tableentries filter(in ([2276,",
				"13673,",
				"17386,",
				"13580,",
				"17882,",
				"13676,",
				"13671,",
				"23025,",
				"13678,",
				"13679,",
				"20390,",
				"23027,",
				"23026,",
				"20389,",
				"18066,",
				"17881,",
				"23028,",
				"19989,",
				"22644,",
				"20619,",
				"17875,",
				"22661,",
				"22952], TABLEENTRIESID)) ~> filter1"
			]
		}
