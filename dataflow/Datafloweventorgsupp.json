				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join6",
				"select2 window(over(ParentID),",
				"     desc(DATECHANGED, true),",
				"     rowno = rowNumber()) ~> window1",
				"window1 filter(rowno == 1) ~> filter6",
				"select7 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          RECID as integer,",
				"          Grid as integer,",
				"          OrgName as string,",
				"          IMPORT_ID as string,",
				"          AdditionalInformation as string,",
				"          Biography as string,",
				"          CapacitytoDonate as string,",
				"          LikelihoodtoDonate as string,",
				"          SalesforceIDorg as string,",
				"          ExpectedRegion as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkevents"
			]
