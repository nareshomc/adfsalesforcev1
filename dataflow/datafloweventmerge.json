{
	"name": "datafloweventmerge",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfeventorgsupp"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "eventssfrecord"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          NAME as string,",
				"          EVENTID as string,",
				"          OrganisedBy as string,",
				"          SupportedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfeventorgsupp",
				"source(output(",
				"          ID as integer,",
				"          Eventid as string,",
				"          EventName as string,",
				"          SalesforceID as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> eventssfrecord",
				"eventssfrecord select(mapColumn(",
				"          Eventid,",
				"          EventName,",
				"          SalesforceID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1"
			]
		}
	}
}