{
	"name": "datafloweventmerge",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfeventorgsupp"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "eventssfrecord"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sinkmerge"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "join1"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          NAME as string,",
				"          EVENTID as string,",
				"          OrganisedBy as string,",
				"          SupportedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfeventorgsupp",
				"source(output(",
				"          ID as integer,",
				"          Eventid as string,",
				"          EventName as string,",
				"          SalesforceID as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> eventssfrecord",
				"eventssfrecord select(mapColumn(",
				"          Eventid,",
				"          EventName,",
				"          SalesforceID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"sfeventorgsupp select(mapColumn(",
				"          NAME,",
				"          EVENTID,",
				"          OrganisedBy,",
				"          SupportedBy",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, select1 join(select2@EVENTID == select1@Eventid,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          EVENTID = select2@EVENTID,",
				"          OrganisedBy,",
				"          SupportedBy,",
				"          EventName,",
				"          SalesforceID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          RECID as integer,",
				"          Grid as integer,",
				"          OrgName as string,",
				"          IMPORT_ID as string,",
				"          AdditionalInformation as string,",
				"          Biography as string,",
				"          CapacitytoDonate as string,",
				"          LikelihoodtoDonate as string,",
				"          SalesforceIDorg as string,",
				"          ExpectedRegion as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkmerge"
			]
		}
	}
}