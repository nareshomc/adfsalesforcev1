{
	"name": "dataflowgiftcodes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "regiftattributes"
				},
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "retableentries"
				},
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "reattributetypes"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "giftcodes"
				}
			],
			"transformations": [
				{
					"name": "selectgiftattribute"
				},
				{
					"name": "selecttabeentries"
				},
				{
					"name": "selectattributetype"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "join2"
				},
				{
					"name": "select2"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ATTRIBUTESID as integer,",
				"          ATTRIBUTETYPESID as integer,",
				"          TEXT as string,",
				"          NUM as integer,",
				"          DATETIME as timestamp,",
				"          CURRENCY as decimal(19,4),",
				"          BOOLEAN as short,",
				"          COMMENTS as string,",
				"          SEQUENCE as short,",
				"          TABLEENTRIESID as integer,",
				"          ATTRIBUTEDATE as date,",
				"          PARENTID as integer,",
				"          IMPORTID as string,",
				"          ConstitID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> regiftattributes",
				"source(output(",
				"          TABLEENTRIESID as integer,",
				"          ACTIVE as short,",
				"          LONGDESCRIPTION as string,",
				"          SHORTDESCRIPTION as string,",
				"          SYSTEMENTRY as short,",
				"          PHONETYPE as short,",
				"          PHONEFORMAT as short,",
				"          SEQUENCE as integer,",
				"          CODETABLESID as integer,",
				"          DATEADDED as timestamp,",
				"          DATECHANGED as timestamp,",
				"          ADDEDBYID as integer,",
				"          LASTCHANGEDBYID as integer,",
				"          NUMERICVALUE as decimal(20,4),",
				"          AWARDAMOUNT as integer,",
				"          AWARDAMTUNITS as short,",
				"          MerchantNumber as string,",
				"          ADDED_BY_ID as integer,",
				"          LAST_CHANGED_BY_ID as integer,",
				"          UKSPECIFIC as short,",
				"          MEMSPECIFIC as short,",
				"          TableNumber as integer,",
				"          RatingsDataType as short,",
				"          PHONETYPENOTSHAREABLE as short,",
				"          INTEGRATION_ID as integer,",
				"          INTEGRATION_DATE_LAST_CHANGED as timestamp,",
				"          PGSpecific as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> retableentries",
				"source(output(",
				"          ATTRIBUTETYPESID as integer,",
				"          RECORDTYPE as short,",
				"          DESCRIPTION as string,",
				"          TYPEOFDATA as short,",
				"          CODETABLESID as integer,",
				"          REQUIRED as short,",
				"          IMPORTID as string,",
				"          SystemMask as integer,",
				"          MUSTBEUNIQUE as short,",
				"          SEQUENCE as integer,",
				"          PRODUCTFLAG as integer,",
				"          COUNTRYMASK as integer,",
				"          ACTIVE as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> reattributetypes",
				"filter1 select(mapColumn(",
				"          ATTRIBUTETYPESID,",
				"          TABLEENTRIESID,",
				"          ATTRIBUTEDATE,",
				"          PARENTID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectgiftattribute",
				"retableentries select(mapColumn(",
				"          TABLEENTRIESID,",
				"          LONGDESCRIPTION",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selecttabeentries",
				"reattributetypes select(mapColumn(",
				"          ATTRIBUTETYPESID,",
				"          DESCRIPTION",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectattributetype",
				"selectgiftattribute, selectattributetype join(selectgiftattribute@ATTRIBUTETYPESID == selectattributetype@ATTRIBUTETYPESID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ATTRIBUTETYPESID = selectgiftattribute@ATTRIBUTETYPESID,",
				"          TABLEENTRIESID,",
				"          ATTRIBUTEDATE,",
				"          PARENTID,",
				"          ATTRIBUTETYPESID = selectattributetype@ATTRIBUTETYPESID,",
				"          DESCRIPTION",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, selecttabeentries join(select1@TABLEENTRIESID == selecttabeentries@TABLEENTRIESID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 select(mapColumn(",
				"          ATTRIBUTETYPESID,",
				"          ATTRIBUTEDATE,",
				"          PARENTID,",
				"          DESCRIPTION,",
				"          LONGDESCRIPTION",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"regiftattributes filter(",
				"in ([838,908,909,910,911,912,913,914,1039,1040,1041,1042,1043,1044,1045], ATTRIBUTETYPESID)) ~> filter1",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> giftcodes"
			]
		}
	}
}