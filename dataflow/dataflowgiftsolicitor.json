{
	"name": "dataflowgiftsolicitor",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "rerecords"
				},
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "regiftsolicitor"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sinksolicitor"
				}
			],
			"transformations": [
				{
					"name": "selectsolicitor"
				},
				{
					"name": "filter1"
				},
				{
					"name": "selectrecords"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ADDED_BY as integer,",
				"          BIRTHPLACE as string,",
				"          BIRTH_DATE as string,",
				"          CONSTITUENT_ID as string,",
				"          DATE_ADDED as timestamp,",
				"          DATE_LAST_CHANGED as timestamp,",
				"          DECEASED_DATE as string,",
				"          EMPLOYEES as integer,",
				"          ETHNICITY as integer,",
				"          FIRST_NAME as string,",
				"          FISCAL_YEAR_STARTS as short,",
				"          IS_HONORMEMORIAL as short,",
				"          ID as integer,",
				"          IMPORT_ID as string,",
				"          INCOME as integer,",
				"          INCOME_LEVEL as integer,",
				"          INDUSTRY as integer,",
				"          KEY_INDICATOR as string,",
				"          KEY_POSITION as short,",
				"          LAST_CHANGED_BY as integer,",
				"          LAST_NAME as string,",
				"          MAIDEN_NAME as string,",
				"          MARITAL_STATUS as integer,",
				"          MATCHING_FACTOR as decimal(20,4),",
				"          MATCHING_GIFT_FLAG as short,",
				"          MATCH_NOTES as string,",
				"          MAX_MATCH_ANNUAL as decimal(20,4),",
				"          MAX_MATCH_PER_GIFT as decimal(20,4),",
				"          MAX_MATCH_TOTAL as decimal(20,4),",
				"          MIDDLE_NAME as string,",
				"          MIN_MATCH_ANNUAL as decimal(20,4),",
				"          MIN_MATCH_PER_GIFT as decimal(20,4),",
				"          MIN_MATCH_TOTAL as decimal(20,4),",
				"          NICKNAME as string,",
				"          ORG_ID as integer,",
				"          ORG_NAME as string,",
				"          PARENT_CORP as string,",
				"          PRIMARY_ADDRESSEE_ID as integer,",
				"          PRIMARY_SALUTATION_ID as integer,",
				"          RECEIPT_TYPE as short,",
				"          RELIGION as integer,",
				"          RO_LINK_ID as integer,",
				"          SEX as short,",
				"          SOCIAL_SECURITY_NO as string,",
				"          SOLICITOR_FLAG as short,",
				"          SPOUSE_ID as integer,",
				"          SUBSIDIARIES as integer,",
				"          SUFFIX_1 as integer,",
				"          SUFFIX_2 as integer,",
				"          TARGET as integer,",
				"          TITLE_1 as integer,",
				"          TITLE_2 as integer,",
				"          ACADEMY_ID as integer,",
				"          IS_CONSTITUENT as short,",
				"          FULL_NAME as string,",
				"          SYNCHRONIZE_FULLNAME as short,",
				"          INACTIVE as short,",
				"          NO_VALID_ADDRESSES as short,",
				"          ANONYMOUS as short,",
				"          PRIMARY_SALUTATION as string,",
				"          PRIMARY_ADDRESSEE as string,",
				"          PRIMARY_ADDRESSEE_EDIT as short,",
				"          PRIMARY_SALUTATION_EDIT as short,",
				"          AnnotationText as string,",
				"          AnnotationAutoDisplay as short,",
				"          PARENT_CORP_ID as integer,",
				"          DECEASED as short,",
				"          SOLICITOR_INACTIVE as short,",
				"          ConstituentPaysTax as short,",
				"          DeclarationMade as timestamp,",
				"          ConfirmationSent as timestamp,",
				"          ConfirmationReturned as timestamp,",
				"          TaxNotes as string,",
				"          NO_EMAIL as short,",
				"          DeclarationEnds as timestamp,",
				"          DeclarationStarts as timestamp,",
				"          TAX_PAYER_STATUS as integer,",
				"          DeclarationIndicator as integer,",
				"          ACADEMY_DATE_LAST_CHANGED as timestamp,",
				"          ACADEMY_LAST_CHANGED_BY as integer,",
				"          INTEGRATION_ID as integer,",
				"          INTEGRATION_DATE_LAST_CHANGED as timestamp,",
				"          AP7VENDORSID as integer,",
				"          INTEGRATION_HASH as string,",
				"          DECLARATIONSOURCE as integer,",
				"          GIVING_SCORE_OVERRIDE as integer,",
				"          USE_BB_GIVING_SCORE as short,",
				"          GIVING_SCORE_OVERRIDE_DATE as timestamp,",
				"          Gender as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> rerecords",
				"source(output(",
				"          ID as integer,",
				"          ParentId as integer,",
				"          SolicitorId as integer,",
				"          Amount as decimal(20,4),",
				"          Sequence as short,",
				"          Import_Id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> regiftsolicitor",
				"regiftsolicitor select(mapColumn(",
				"          ParentId,",
				"          SolicitorId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectsolicitor",
				"rerecords filter(INACTIVE == 0 && KEY_INDICATOR == 'I' && SOLICITOR_FLAG == -1) ~> filter1",
				"filter1 select(mapColumn(",
				"          RECID = ID,",
				"          FirstName = FIRST_NAME,",
				"          LastName = LAST_NAME",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectrecords",
				"selectsolicitor, selectrecords join(SolicitorId == RECID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ParentId,",
				"          SolicitorId,",
				"          RECID,",
				"          FirstName,",
				"          LastName",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          CONSTITUENT_ID as string,",
				"          FIRST_NAME as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          LAST_NAME as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentAmount as decimal(20,4),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          SalesforceID as string,",
				"          DonorId as string,",
				"          SalesforceGCId as string,",
				"          EffectiveStartDate as date,",
				"          Gift_Type__c as string,",
				"          Status as string,",
				"          ExpectedTotalCmtAmount as decimal(16,2),",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          ParentId,",
				"          SolicitorId,",
				"          RECID,",
				"          FirstName,",
				"          LastName",
				"     )) ~> sinksolicitor"
			]
		}
	}
}