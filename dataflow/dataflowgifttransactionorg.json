{
	"name": "dataflowgifttransactionorg",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "giftorg"
				},
				{
					"dataset": {
						"referenceName": "ds_redb",
						"type": "DatasetReference"
					},
					"name": "installmenthistory"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfgcscheduleorg"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sftransaction"
				}
			],
			"transformations": [
				{
					"name": "selectgift"
				},
				{
					"name": "selecthistory"
				},
				{
					"name": "filter1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select2"
				},
				{
					"name": "join2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ACKNOWLEDGE_FLAG as short,",
				"          ADDEDBYID as integer,",
				"          AMOUNT_SUBJECT_TO_VAT as decimal(30,6),",
				"          ANONYMOUS as short,",
				"          AUTHORIZATION_CODE as string,",
				"          CONSTITUENTBANKID as integer,",
				"          BATCH_NUMBER as string,",
				"          BROKER_FEE as decimal(30,6),",
				"          CHECK_DATE as string,",
				"          CHECK_NUMBER as string,",
				"          CLAIM_NO as string,",
				"          CONSTITUENT_CODE as integer,",
				"          CONSTIT_ID as integer,",
				"          GIFT_STATUS as short,",
				"          CREDIT_TYPE as integer,",
				"          CURRENCY_AMOUNT as decimal(30,6),",
				"          CURRENCY_COUNTRY as integer,",
				"          CURRENCY_EXCHANGE_RATE as decimal(34,10),",
				"          CURRENCY_RECEIPT_AMOUNT as decimal(30,6),",
				"          DATE_1ST_PAY as date,",
				"          DATEADDED as timestamp,",
				"          DATECHANGED as timestamp,",
				"          DTE as date,",
				"          EXPIRES_ON as string,",
				"          GIFT_CODE as integer,",
				"          ID as integer,",
				"          IMPORT_ID as string,",
				"          INSTALLMENT_FREQUENCY as short,",
				"          LASTCHANGEDBYID as integer,",
				"          LETTER_CODE as integer,",
				"          MG_SOURCE_CONSTIT_ID as integer,",
				"          NUMBER_OF_INSTALLMENTS as short,",
				"          PAYMENT_TYPE as short,",
				"          POST_DATE as timestamp,",
				"          POST_STATUS as short,",
				"          RECEIPT_AMOUNT as decimal(30,6),",
				"          RECEIPT_FLAG as short,",
				"          RECEIPT_NUMBER as integer,",
				"          REF as string,",
				"          REFERENCE_DATE as string,",
				"          REFERENCE_NUMBER as string,",
				"          REMIND_FLAG as short,",
				"          SALE_OF_STOCK_POST_DATE as timestamp,",
				"          SALE_OF_STOCK_POST_STATUS as short,",
				"          STANDING_ORDER_SENT as short,",
				"          STOCK_SALE_COMMENT as string,",
				"          STOCK_SALE_DATE as timestamp,",
				"          STOCK_SALE_VALUE as decimal(30,6),",
				"          TYPE as integer,",
				"          VAT_TAX_CODE as integer,",
				"          EFT_ID as integer,",
				"          DRAWER as string,",
				"          Issuer as string,",
				"          IssuerSymbol as string,",
				"          IssuerNumUnits as integer,",
				"          IssuerMedianPrice as decimal(30,6),",
				"          BenefitsNotes as string,",
				"          BenefitsIncludeNotes as short,",
				"          UserGiftId as string,",
				"          GiftSubType as integer,",
				"          AmountBills as decimal(20,4),",
				"          AmountCoins as decimal(20,4),",
				"          StandingOrderSentDate as string,",
				"          Amount as decimal(20,4),",
				"          AcknowledgeDate as string,",
				"          ReceiptDate as string,",
				"          Schedule_Month as short,",
				"          Schedule_DayOfMonth as short,",
				"          Schedule_MonthlyDayOfWeek as short,",
				"          Schedule_Spacing as short,",
				"          Schedule_MonthlyType as short,",
				"          Schedule_MonthlyOrdinal as short,",
				"          Schedule_WeeklyDayOfWeek as short,",
				"          AdjustmentNotes as string,",
				"          ProcessedByEFT as short,",
				"          OrderType as short,",
				"          Received as short,",
				"          Schedule_DayOfMonth2 as short,",
				"          Schedule_SMDayType1 as short,",
				"          Schedule_SMDayType2 as short,",
				"          VAT_Amount_Charged as decimal(20,4),",
				"          AdjustmentForSaleOfStock as short,",
				"          GLJournalReference as string,",
				"          TransactionPending as short,",
				"          SendPrenotification as short,",
				"          Last_Prenote_Sent_Date as timestamp,",
				"          Send_Prenote_Units as short,",
				"          NextTransactionDate as timestamp,",
				"          Schedule_EndDate as timestamp,",
				"          GLReversalOriginalGiftType as short,",
				"          GLReversalConstituentName as string,",
				"          GLReversalConstituentID as string,",
				"          GLReversalConstitID as integer,",
				"          GLReversalKeyName as string,",
				"          GLReversalMiddleName as string,",
				"          GLReversalFirstName as string,",
				"          GLReversalOriginalGiftID as integer,",
				"          TaxCanBeClaimed as short,",
				"          TaxClaimAmount as decimal(20,4),",
				"          VoucherAgency as integer,",
				"          SendInstruction as short,",
				"          InstructionType as short,",
				"          InstructionSentDate as timestamp,",
				"          InstructionCancelDate as timestamp,",
				"          InstructionSetupDate as timestamp,",
				"          AdvanceNoticeSentDate as timestamp,",
				"          FrequencyDescription as string,",
				"          CardholderName as string,",
				"          Continuous as short,",
				"          DDIReceivedDate as timestamp,",
				"          DDISource as integer,",
				"          ReceiptStack as integer,",
				"          AckLetterActionID as integer,",
				"          TaxEligibleCovenant as short,",
				"          GiftStatusDate as string,",
				"          EnvelopeID as string,",
				"          AccountID as integer,",
				"          UseAdjPDte4RevPDte as short,",
				"          GIFTAIDQMETHOD as short,",
				"          GIFTAIDQSTATUS as short,",
				"          CREDIT_CARD_NUMBER as string,",
				"          REVERSEPOSTING as short,",
				"          REFUNDTAX as short,",
				"          CLAIM_REFUNDNUMBER as string,",
				"          ARCHIVEDGIFT as short,",
				"          REPLACEMENTGIFTID as integer,",
				"          PlannedGiftID as integer,",
				"          CARDTOKEN as string,",
				"          NXTGift as short,",
				"          BBCheckoutID as string,",
				"          BBPSTransactionID as string,",
				"          Origin as string,",
				"          BBPSConfigurationID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from dbo.gift3 where id in (7604151, 8392505)',",
				"     format: 'query') ~> giftorg",
				"source(output(",
				"          InstallmentPaymentId as integer,",
				"          InstallmentId as integer,",
				"          PaymentId as integer,",
				"          PledgeId as integer,",
				"          Amount as decimal(20,4)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> installmenthistory",
				"source(output(",
				"          OrgName as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentID as integer,",
				"          InstallmentAmount as decimal(20,4),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          SalesforceIDorg as string,",
				"          DonorId as string,",
				"          SalesforceGCId as string,",
				"          EffectiveStartDate as date,",
				"          Gift_Type__c as string,",
				"          Status as string,",
				"          ExpectedTotalCmtAmount as decimal(16,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfgcscheduleorg",
				"filter1 select(mapColumn(",
				"          ActualAmount = AMOUNT_SUBJECT_TO_VAT,",
				"          CONSTIT_ID,",
				"          DATE_1ST_PAY,",
				"          GiftDate = DTE,",
				"          GIFTid = ID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectgift",
				"filter2 select(mapColumn(",
				"          InstallmentId,",
				"          PaymentId,",
				"          PledgeId,",
				"          Amount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selecthistory",
				"giftorg filter(in ([7604151, 8392505], ID)) ~> filter1",
				"selectgift, selecthistory join(GIFTid == PledgeId,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ActualAmount,",
				"          CONSTIT_ID,",
				"          DATE_1ST_PAY,",
				"          GiftDate,",
				"          GIFTid,",
				"          Amount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"installmenthistory filter(in ([7604151, 8392505], PledgeId)) ~> filter2",
				"sfgcscheduleorg select(mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType,",
				"          SalesforceIDorg,",
				"          DonorId,",
				"          SalesforceGCId,",
				"          EffectiveStartDate,",
				"          Gift_Type__c,",
				"          Status,",
				"          ExpectedTotalCmtAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1, select2 join(select1@GIFTid == select2@GiftID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"select3 aggregate(groupBy(select3@GIFTid,",
				"          SalesforceIDorg,",
				"          DonorId,",
				"          SalesforceGCId,",
				"          Amount),",
				"     ExpectedTotalCmtAmount = max(ExpectedTotalCmtAmount)) ~> aggregate1",
				"join2 select(mapColumn(",
				"          ActualAmount,",
				"          CONSTIT_ID = select1@CONSTIT_ID,",
				"          DATE_1ST_PAY,",
				"          GiftDate = select1@GiftDate,",
				"          GIFTid = select1@GIFTid,",
				"          Amount = select1@Amount,",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate = select2@GiftDate,",
				"          StatusDate,",
				"          Amount = select2@Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID = select2@CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID = select2@GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType,",
				"          SalesforceIDorg,",
				"          DonorId,",
				"          SalesforceGCId,",
				"          EffectiveStartDate,",
				"          Gift_Type__c,",
				"          Status,",
				"          ExpectedTotalCmtAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          OrgName as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentID as integer,",
				"          InstallmentAmount as decimal(20,4),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          SalesforceIDorg as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sftransaction"
			]
		}
	}
}