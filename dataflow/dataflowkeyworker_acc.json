{
	"name": "dataflowkeyworker_acc",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sourcekeyworker"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfpledgemergeorg"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sinkkeyworkers"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "selectmergerecord"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as integer,",
				"          ParentId as integer,",
				"          SolicitorId as integer,",
				"          RECID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourcekeyworker",
				"source(output(",
				"          CONSTITUENT_ID as string,",
				"          FIRST_NAME as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          LAST_NAME as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentAmount as decimal(20,4),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          SalesforceID as string,",
				"          DonorId as string,",
				"          SalesforceGCId as string,",
				"          EffectiveStartDate as date,",
				"          Gift_Type__c as string,",
				"          Status as string,",
				"          ExpectedTotalCmtAmount as decimal(16,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfpledgemergeorg",
				"sourcekeyworker derive(PersonName = trim(concat(iifNull(FirstName, ''), ' ', iifNull(LastName, '')))) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          ParentId,",
				"          SolicitorId,",
				"          RECID,",
				"          PersonName",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"sfpledgemergeorg select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          FIRST_NAME,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          LAST_NAME,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType,",
				"          SalesforceID,",
				"          DonorId,",
				"          SalesforceGCId,",
				"          EffectiveStartDate,",
				"          Gift_Type__c,",
				"          Status,",
				"          ExpectedTotalCmtAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectmergerecord",
				"select1, selectmergerecord join(ParentId == GiftID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ParentId,",
				"          SolicitorId,",
				"          RECID = select1@RECID,",
				"          PersonName,",
				"          CONSTITUENT_ID,",
				"          FIRST_NAME,",
				"          RECID = selectmergerecord@RECID,",
				"          IMPORT_IDrec,",
				"          LAST_NAME,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType,",
				"          SalesforceID,",
				"          DonorId,",
				"          SalesforceGCId,",
				"          EffectiveStartDate,",
				"          Gift_Type__c,",
				"          Status,",
				"          ExpectedTotalCmtAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 aggregate(groupBy(PersonName,",
				"          ParentId,",
				"          SalesforceGCId,",
				"          DonorId,",
				"          SalesforceID,",
				"          PersonName),",
				"     GiftID = first(GiftID)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkkeyworkers"
			]
		}
	}
}