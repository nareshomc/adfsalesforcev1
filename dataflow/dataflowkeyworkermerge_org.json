{
	"name": "dataflowkeyworkermerge_org",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfgcscheduleorg"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfgiftcodes"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "resfgiftcodesorg"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "selectgiftcodes"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          RECID as integer,",
				"          OrgName as string,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as string,",
				"          IMPORT_IDgift as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          Reference as string,",
				"          InstallmentFrequency as string,",
				"          ScheduleType as string,",
				"          InstallmentDate as date,",
				"          InstallmentAmount as decimal(20,4),",
				"          SalesforceIDorg as string,",
				"          DonorId as string,",
				"          SalesforceGCid as string,",
				"          EffectiveStartDate as date,",
				"          Gift_Type__c as string,",
				"          GiftID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfgcscheduleorg",
				"source(output(",
				"          ATTRIBUTETYPESID as integer,",
				"          ATTRIBUTEDATE as date,",
				"          PARENTID as integer,",
				"          RcodeType as string,",
				"          RCode as string,",
				"          GiftDesignationCode as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfgiftcodes",
				"sfgcscheduleorg select(mapColumn(",
				"          RECID,",
				"          OrgName,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          IMPORT_IDgift,",
				"          GiftType,",
				"          Name,",
				"          Reference,",
				"          InstallmentFrequency,",
				"          ScheduleType,",
				"          InstallmentDate,",
				"          InstallmentAmount,",
				"          SalesforceIDorg,",
				"          DonorId,",
				"          SalesforceGCid,",
				"          EffectiveStartDate,",
				"          Gift_Type__c,",
				"          GiftID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"sfgiftcodes select(mapColumn(",
				"          ATTRIBUTETYPESID,",
				"          PARENTID,",
				"          RcodeType,",
				"          RCode,",
				"          GiftDesignationCode",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectgiftcodes",
				"select1, selectgiftcodes join(GiftID == PARENTID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          RECID,",
				"          OrgName,",
				"          GRId,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          IMPORT_IDgift,",
				"          GiftType,",
				"          Name,",
				"          Reference,",
				"          InstallmentFrequency,",
				"          ScheduleType,",
				"          InstallmentDate,",
				"          InstallmentAmount,",
				"          SalesforceIDorg,",
				"          DonorId,",
				"          SalesforceGCid,",
				"          GiftID,",
				"          PARENTID,",
				"          RcodeType,",
				"          RCode,",
				"          GiftDesignationCode",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> resfgiftcodesorg"
			]
		}
	}
}