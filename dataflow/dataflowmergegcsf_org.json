{
	"name": "dataflowmergegcsf_org",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfpledgemergeorg"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfgiftcommitmentsforg"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          RECID as integer,",
				"          OrgName as string,",
				"          CONSTITUENT_ID as string,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as string,",
				"          IMPORT_IDgift as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          Reference as string,",
				"          InstallmentFrequency as string,",
				"          ScheduleType as string,",
				"          InstallmentDate as date,",
				"          InstallmentAmount as decimal(20,4),",
				"          SalesforceIDorg as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfpledgemergeorg",
				"source(output(",
				"          Id as string,",
				"          Name as string,",
				"          EffectiveStartDate as timestamp,",
				"          Gift_Type__c as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfgiftcommitmentsforg",
				"filter1 select(mapColumn(",
				"          RECID,",
				"          OrgName,",
				"          CONSTITUENT_ID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          IMPORT_IDgift,",
				"          GiftType,",
				"          Name,",
				"          Reference,",
				"          InstallmentFrequency,",
				"          ScheduleType,",
				"          InstallmentDate,",
				"          InstallmentAmount,",
				"          SalesforceIDorg",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"sfpledgemergeorg filter(SalesforceIDorg == '001Qz00000cYx2EIAS') ~> filter1"
			]
		}
	}
}