{
	"name": "dataflowmergegcsf_org",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfpledgemergeorg"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfgiftcommitmentsforg"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "gcscheduleordg"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "selectsfgccommorg"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as integer,",
				"          CONSTITUENT_ID as string,",
				"          OrgName as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,2),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentAmount as decimal(20,2),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfpledgemergeorg",
				"source(output(",
				"          ID as integer,",
				"          CONSTITUENT_ID as string,",
				"          OrgName as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,2),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentAmount as decimal(20,2),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfgiftcommitmentsforg",
				"filter1 select(mapColumn(",
				"          RECID,",
				"          OrgName,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          IMPORT_IDgift,",
				"          GiftType,",
				"          Name,",
				"          Reference,",
				"          InstallmentFrequency,",
				"          ScheduleType,",
				"          InstallmentDate,",
				"          InstallmentAmount,",
				"          SalesforceIDorg,",
				"          GiftID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"sfpledgemergeorg filter(in  (['001Qz00000cYx2EIAS', '001Qz00000cYyL9IAK'],SalesforceIDorg)) ~> filter1",
				"sfgiftcommitmentsforg select(mapColumn(",
				"          DonorId,",
				"          SalesforceGCid = Id,",
				"          Name,",
				"          EffectiveStartDate,",
				"          Gift_Type__c,",
				"          Status,",
				"          ExpectedTotalCmtAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectsfgccommorg",
				"select1, selectsfgccommorg join(SalesforceIDorg == DonorId",
				"     && GiftDate == EffectiveStartDate",
				"     && GiftStatus == Status",
				"     && Amount == ExpectedTotalCmtAmount,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          RECID,",
				"          OrgName,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          IMPORT_IDgift,",
				"          GiftType,",
				"          Name = select1@Name,",
				"          Reference,",
				"          InstallmentFrequency,",
				"          ScheduleType,",
				"          InstallmentDate,",
				"          InstallmentAmount,",
				"          SalesforceIDorg,",
				"          DonorId,",
				"          SalesforceGCid,",
				"          EffectiveStartDate,",
				"          Gift_Type__c,",
				"          GiftID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          CONSTITUENT_ID as string,",
				"          OrgName as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,2),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentAmount as decimal(20,2),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> gcscheduleordg"
			]
		}
	}
}