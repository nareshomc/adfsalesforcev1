{
	"name": "dataflowmergepledgeacc",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfpledgeacc"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfgiftcodes"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfgiftsolicitor"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CONSTITUENT_ID as string,",
				"          FIRST_NAME as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          LAST_NAME as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as short,",
				"          InstallmentFrequency as short,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentAmount as decimal(20,4)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfpledgeacc",
				"source(output(",
				"          ATTRIBUTETYPESID as integer,",
				"          ATTRIBUTEDATE as date,",
				"          PARENTID as integer,",
				"          DESCRIPTION as string,",
				"          LONGDESCRIPTION as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfgiftcodes",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfgiftsolicitor",
				"sfpledgeacc select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          FIRST_NAME,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          LAST_NAME,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1"
			]
		}
	}
}