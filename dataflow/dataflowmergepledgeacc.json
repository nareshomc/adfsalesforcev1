{
	"name": "dataflowmergepledgeacc",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfpledge"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "salesforceorg"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sinkpledgemerge"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "selectsalesforceid"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as integer,",
				"          ParentId as integer,",
				"          SolicitorId as integer,",
				"          RECID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfpledge",
				"source(output(",
				"          ID as integer,",
				"          ParentId as integer,",
				"          SolicitorId as integer,",
				"          RECID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> salesforceorg",
				"sfpledge select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, selectsalesforceid join(select1@GRId == selectsalesforceid@GRID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          OrgName,",
				"          RECID = select1@RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType,",
				"          SalesforceIDorg",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"salesforceorg select(mapColumn(",
				"          GRID,",
				"          RECID,",
				"          Organisationname,",
				"          SalesforceIDorg = SalesforceID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectsalesforceid",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          ParentId as integer,",
				"          SolicitorId as integer,",
				"          RECID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkpledgemerge"
			]
		}
	}
}