{
	"name": "dataflowmergepledgeorg",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sfpledge"
				},
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "salesforceacc"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_migrationdb",
						"type": "DatasetReference"
					},
					"name": "sinkpledgemerge"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "selectsalesforceid"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as integer,",
				"          OrgName as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentID as integer,",
				"          InstallmentAmount as decimal(20,4),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          SalesforceIDorg as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sfpledge",
				"source(output(",
				"          ID as integer,",
				"          GRID as integer,",
				"          RECID as string,",
				"          OrganisationName as string,",
				"          SalesforceID as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> salesforceacc",
				"sfpledge select(mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, selectsalesforceid join(select1@GRId == selectsalesforceid@GRID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          OrgName,",
				"          RECID = select1@RECID,",
				"          IMPORT_IDrec,",
				"          GRId = select1@GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType,",
				"          GRID = selectsalesforceid@GRID,",
				"          RECID = selectsalesforceid@RECID,",
				"          OrganisationName,",
				"          SalesforceIDorg",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"salesforceacc select(mapColumn(",
				"          GRID,",
				"          RECID,",
				"          OrganisationName,",
				"          SalesforceIDorg = SalesforceID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectsalesforceid",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as integer,",
				"          OrgName as string,",
				"          RECID as integer,",
				"          IMPORT_IDrec as string,",
				"          GRId as integer,",
				"          GiftDate as date,",
				"          StatusDate as date,",
				"          Amount as decimal(20,4),",
				"          GiftStatus as string,",
				"          InstallmentFrequency as string,",
				"          CONSTIT_ID as integer,",
				"          IMPORT_IDgift as string,",
				"          GiftID as integer,",
				"          InstallmentID as integer,",
				"          InstallmentAmount as decimal(20,4),",
				"          InstallmentDate as date,",
				"          Reference as string,",
				"          GiftType as string,",
				"          Name as string,",
				"          ScheduleType as string,",
				"          SalesforceIDorg as string,",
				"          CURRENT_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType,",
				"          SalesforceIDorg",
				"     )) ~> sinkpledgemerge"
			]
		}
	}
}