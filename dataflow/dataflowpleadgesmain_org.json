				"          MATCHING_GIFT_FLAG as short,",
				"          MATCH_NOTES as string,",
				"          MAX_MATCH_ANNUAL as decimal(20,4),",
				"          MAX_MATCH_PER_GIFT as decimal(20,4),",
				"          MAX_MATCH_TOTAL as decimal(20,4),",
				"          MIDDLE_NAME as string,",
				"          MIN_MATCH_ANNUAL as decimal(20,4),",
				"          MIN_MATCH_PER_GIFT as decimal(20,4),",
				"          MIN_MATCH_TOTAL as decimal(20,4),",
				"          NICKNAME as string,",
				"          ORG_ID as integer,",
				"          ORG_NAME as string,",
				"          PARENT_CORP as string,",
				"          PRIMARY_ADDRESSEE_ID as integer,",
				"          PRIMARY_SALUTATION_ID as integer,",
				"          RECEIPT_TYPE as short,",
				"          RELIGION as integer,",
				"          RO_LINK_ID as integer,",
				"          SEX as short,",
				"          SOCIAL_SECURITY_NO as string,",
				"          SOLICITOR_FLAG as short,",
				"          SPOUSE_ID as integer,",
				"          SUBSIDIARIES as integer,",
				"          SUFFIX_1 as integer,",
				"          SUFFIX_2 as integer,",
				"          TARGET as integer,",
				"          TITLE_1 as integer,",
				"          TITLE_2 as integer,",
				"          ACADEMY_ID as integer,",
				"          IS_CONSTITUENT as short,",
				"          FULL_NAME as string,",
				"          SYNCHRONIZE_FULLNAME as short,",
				"          INACTIVE as short,",
				"          NO_VALID_ADDRESSES as short,",
				"          ANONYMOUS as short,",
				"          PRIMARY_SALUTATION as string,",
				"          PRIMARY_ADDRESSEE as string,",
				"          PRIMARY_ADDRESSEE_EDIT as short,",
				"          PRIMARY_SALUTATION_EDIT as short,",
				"          AnnotationText as string,",
				"          AnnotationAutoDisplay as short,",
				"          PARENT_CORP_ID as integer,",
				"          DECEASED as short,",
				"          SOLICITOR_INACTIVE as short,",
				"          ConstituentPaysTax as short,",
				"          DeclarationMade as timestamp,",
				"          ConfirmationSent as timestamp,",
				"          ConfirmationReturned as timestamp,",
				"          TaxNotes as string,",
				"          NO_EMAIL as short,",
				"          DeclarationEnds as timestamp,",
				"          DeclarationStarts as timestamp,",
				"          TAX_PAYER_STATUS as integer,",
				"          DeclarationIndicator as integer,",
				"          ACADEMY_DATE_LAST_CHANGED as timestamp,",
				"          ACADEMY_LAST_CHANGED_BY as integer,",
				"          INTEGRATION_ID as integer,",
				"          INTEGRATION_DATE_LAST_CHANGED as timestamp,",
				"          AP7VENDORSID as integer,",
				"          INTEGRATION_HASH as string,",
				"          DECLARATIONSOURCE as integer,",
				"          GIVING_SCORE_OVERRIDE as integer,",
				"          USE_BB_GIVING_SCORE as short,",
				"          GIVING_SCORE_OVERRIDE_DATE as timestamp,",
				"          Gender as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> rerecords",
				"source(output(",
				"          Source as string,",
				"          SourceId as integer,",
				"          GoldenRank as integer,",
				"          GRId as integer,",
				"          OriginalSource as string,",
				"          GiftAidOriginalSource as string,",
				"          OriginalCreationDate as timestamp,",
				"          LastChangeDate as timestamp,",
				"          CreationDate as timestamp,",
				"          CreationSource as string,",
				"          UpdateDate as timestamp,",
				"          UpdateSource as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sepredata",
				"source(output(",
				"          InstallmentId as integer,",
				"          PledgeId as integer,",
				"          AdjustmentId as integer,",
				"          Amount as decimal(20,4),",
				"          Dte as date,",
				"          Sequence as short,",
				"          Year as short,",
				"          Import_Id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> reinstallment",
				"source(output(",
				"          ACKNOWLEDGE_FLAG as short,",
				"          ADDEDBYID as integer,",
				"          AMOUNT_SUBJECT_TO_VAT as decimal(30,6),",
				"          ANONYMOUS as short,",
				"          AUTHORIZATION_CODE as string,",
				"          CONSTITUENTBANKID as integer,",
				"          BATCH_NUMBER as string,",
				"          BROKER_FEE as decimal(30,6),",
				"          CHECK_DATE as string,",
				"          CHECK_NUMBER as string,",
				"          CLAIM_NO as string,",
				"          CONSTITUENT_CODE as integer,",
				"          CONSTIT_ID as integer,",
				"          GIFT_STATUS as short,",
				"          CREDIT_TYPE as integer,",
				"          CURRENCY_AMOUNT as decimal(30,6),",
				"          CURRENCY_COUNTRY as integer,",
				"          CURRENCY_EXCHANGE_RATE as decimal(34,10),",
				"          CURRENCY_RECEIPT_AMOUNT as decimal(30,6),",
				"          DATE_1ST_PAY as timestamp,",
				"          DATEADDED as timestamp,",
				"          DATECHANGED as timestamp,",
				"          DTE as date,",
				"          EXPIRES_ON as string,",
				"          GIFT_CODE as integer,",
				"          ID as integer,",
				"          IMPORT_ID as string,",
				"          INSTALLMENT_FREQUENCY as short,",
				"          LASTCHANGEDBYID as integer,",
				"          LETTER_CODE as integer,",
				"          MG_SOURCE_CONSTIT_ID as integer,",
				"          NUMBER_OF_INSTALLMENTS as short,",
				"          PAYMENT_TYPE as short,",
				"          POST_DATE as date,",
				"          POST_STATUS as short,",
				"          RECEIPT_AMOUNT as decimal(30,6),",
				"          RECEIPT_FLAG as short,",
				"          RECEIPT_NUMBER as integer,",
				"          REF as string,",
				"          REFERENCE_DATE as string,",
				"          REFERENCE_NUMBER as string,",
				"          REMIND_FLAG as short,",
				"          SALE_OF_STOCK_POST_DATE as timestamp,",
				"          SALE_OF_STOCK_POST_STATUS as short,",
				"          STANDING_ORDER_SENT as short,",
				"          STOCK_SALE_COMMENT as string,",
				"          STOCK_SALE_DATE as timestamp,",
				"          STOCK_SALE_VALUE as decimal(30,6),",
				"          TYPE as integer,",
				"          VAT_TAX_CODE as integer,",
				"          EFT_ID as integer,",
				"          DRAWER as string,",
				"          Issuer as string,",
				"          IssuerSymbol as string,",
				"          IssuerNumUnits as integer,",
				"          IssuerMedianPrice as decimal(30,6),",
				"          BenefitsNotes as string,",
				"          BenefitsIncludeNotes as short,",
				"          UserGiftId as string,",
				"          GiftSubType as integer,",
				"          AmountBills as decimal(20,4),",
				"          AmountCoins as decimal(20,4),",
				"          StandingOrderSentDate as string,",
				"          Amount as decimal(20,4),",
				"          AcknowledgeDate as string,",
				"          ReceiptDate as string,",
				"          Schedule_Month as short,",
				"          Schedule_DayOfMonth as short,",
				"          Schedule_MonthlyDayOfWeek as short,",
				"          Schedule_Spacing as short,",
				"          Schedule_MonthlyType as short,",
				"          Schedule_MonthlyOrdinal as short,",
				"          Schedule_WeeklyDayOfWeek as short,",
				"          AdjustmentNotes as string,",
				"          ProcessedByEFT as short,",
				"          OrderType as short,",
				"          Received as short,",
				"          Schedule_DayOfMonth2 as short,",
				"          Schedule_SMDayType1 as short,",
				"          Schedule_SMDayType2 as short,",
				"          VAT_Amount_Charged as decimal(20,4),",
				"          AdjustmentForSaleOfStock as short,",
				"          GLJournalReference as string,",
				"          TransactionPending as short,",
				"          SendPrenotification as short,",
				"          Last_Prenote_Sent_Date as timestamp,",
				"          Send_Prenote_Units as short,",
				"          NextTransactionDate as timestamp,",
				"          Schedule_EndDate as timestamp,",
				"          GLReversalOriginalGiftType as short,",
				"          GLReversalConstituentName as string,",
				"          GLReversalConstituentID as string,",
				"          GLReversalConstitID as integer,",
				"          GLReversalKeyName as string,",
				"          GLReversalMiddleName as string,",
				"          GLReversalFirstName as string,",
				"          GLReversalOriginalGiftID as integer,",
				"          TaxCanBeClaimed as short,",
				"          TaxClaimAmount as decimal(20,4),",
				"          VoucherAgency as integer,",
				"          SendInstruction as short,",
				"          InstructionType as short,",
				"          InstructionSentDate as timestamp,",
				"          InstructionCancelDate as timestamp,",
				"          InstructionSetupDate as timestamp,",
				"          AdvanceNoticeSentDate as timestamp,",
				"          FrequencyDescription as string,",
				"          CardholderName as string,",
				"          Continuous as short,",
				"          DDIReceivedDate as timestamp,",
				"          DDISource as integer,",
				"          ReceiptStack as integer,",
				"          AckLetterActionID as integer,",
				"          TaxEligibleCovenant as short,",
				"          GiftStatusDate as string,",
				"          EnvelopeID as string,",
				"          AccountID as integer,",
				"          UseAdjPDte4RevPDte as short,",
				"          GIFTAIDQMETHOD as short,",
				"          GIFTAIDQSTATUS as short,",
				"          CREDIT_CARD_NUMBER as string,",
				"          REVERSEPOSTING as short,",
				"          REFUNDTAX as short,",
				"          CLAIM_REFUNDNUMBER as string,",
				"          ARCHIVEDGIFT as short,",
				"          REPLACEMENTGIFTID as integer,",
				"          PlannedGiftID as integer,",
				"          CARDTOKEN as string,",
				"          NXTGift as short,",
				"          BBCheckoutID as string,",
				"          BBPSTransactionID as string,",
				"          Origin as string,",
				"          BBPSConfigurationID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> regifts",
				"rerecords filter(INACTIVE == 0 && KEY_INDICATOR == 'O') ~> filter1",
				"filter1 select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          OrgName = ORG_NAME,",
				"          RECID = ID,",
				"          IMPORT_ID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"sepredata filter(OriginalSource == 'RE') ~> filter2",
				"filter2 select(mapColumn(",
				"          SourceId,",
				"          GRId,",
				"          OriginalSource",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectsepredata",
				"select1, selectsepredata join(RECID == SourceId,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_ID,",
				"          GRId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"reinstallment select(mapColumn(",
				"          PledgeId,",
				"          InstallmentAmount = Amount,",
				"          InstallmentDate = Dte",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectreinstallment",
				"regifts filter(! isNull(DATE_1ST_PAY) && TYPE == 8) ~> filter3",
				"derivedColumn1 select(mapColumn(",
				"          GiftDate = DTE,",
				"          StatusDate = POST_DATE,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift = IMPORT_ID,",
				"          GiftID = ID,",
				"          Reference = REF",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectgifts",
				"select2, selectgifts join(RECID == CONSTIT_ID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec = IMPORT_ID,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          Reference",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4, selectreinstallment join(GiftID == PledgeId,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"filter3 derive(InstallmentFrequency = case(",
				"    INSTALLMENT_FREQUENCY == 1, 'Annually',",
				"    INSTALLMENT_FREQUENCY == 2, 'Semi-Annually',",
				"    INSTALLMENT_FREQUENCY == 3, 'Quarterly',",
				"    INSTALLMENT_FREQUENCY == 5, 'Monthly',",
				"    INSTALLMENT_FREQUENCY == 9, 'Irregular',",
				"    INSTALLMENT_FREQUENCY == 10, 'Single Instalment',",
				"",
				"    'Unknown'",
				"),",
				"          GiftStatus = case(",
				"    GIFT_STATUS == 1, 'Active',",
				"    GIFT_STATUS == 2, 'Held',",
				"    GIFT_STATUS == 4, 'Completed',",
				"    GIFT_STATUS == 5, 'Cancelled',",
				"    'Unknown'",
				")) ~> derivedColumn1",
				"select5 derive(GiftType = 'Pledge',",
				"          Name = 'Historic Pledge',",
				"          ScheduleType = 'Custom') ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"derivedColumn2 select(mapColumn(",
				"          CONSTITUENT_ID,",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          CONSTIT_ID,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          InstallmentAmount,",
				"          InstallmentDate,",
				"          Reference,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"select7 aggregate(groupBy(CONSTITUENT_ID,",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_IDrec,",
				"          GRId,",
				"          GiftDate,",
				"          StatusDate,",
				"          Amount,",
				"          GiftStatus,",
				"          InstallmentFrequency,",
				"          IMPORT_IDgift,",
				"          GiftID,",
				"          GiftType,",
				"          Name,",
				"          ScheduleType),",
				"     InstallmentDate = first(InstallmentDate),",
				"          InstallmentAmount = first(InstallmentAmount)) ~> aggregate1",
				"select6 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> pledgerecords",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sfpledgeorgagg"
			]
		}
	}
}