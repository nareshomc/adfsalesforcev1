			"scriptLines": [
				"source(output(",
				"          ADDED_BY as integer,",
				"          BIRTHPLACE as string,",
				"          BIRTH_DATE as string,",
				"          CONSTITUENT_ID as string,",
				"          DATE_ADDED as timestamp,",
				"          DATE_LAST_CHANGED as timestamp,",
				"          DECEASED_DATE as string,",
				"          EMPLOYEES as integer,",
				"          ETHNICITY as integer,",
				"          FIRST_NAME as string,",
				"          FISCAL_YEAR_STARTS as short,",
				"          IS_HONORMEMORIAL as short,",
				"          ID as integer,",
				"          IMPORT_ID as string,",
				"          INCOME as integer,",
				"          INCOME_LEVEL as integer,",
				"          INDUSTRY as integer,",
				"          KEY_INDICATOR as string,",
				"          KEY_POSITION as short,",
				"          LAST_CHANGED_BY as integer,",
				"          LAST_NAME as string,",
				"          MAIDEN_NAME as string,",
				"          MARITAL_STATUS as integer,",
				"          MATCHING_FACTOR as decimal(20,4),",
				"          MATCHING_GIFT_FLAG as short,",
				"          MATCH_NOTES as string,",
				"          MAX_MATCH_ANNUAL as decimal(20,4),",
				"          MAX_MATCH_PER_GIFT as decimal(20,4),",
				"          MAX_MATCH_TOTAL as decimal(20,4),",
				"          MIDDLE_NAME as string,",
				"          MIN_MATCH_ANNUAL as decimal(20,4),",
				"          MIN_MATCH_PER_GIFT as decimal(20,4),",
				"          MIN_MATCH_TOTAL as decimal(20,4),",
				"          NICKNAME as string,",
				"          ORG_ID as integer,",
				"          ORG_NAME as string,",
				"          PARENT_CORP as string,",
				"          PRIMARY_ADDRESSEE_ID as integer,",
				"          PRIMARY_SALUTATION_ID as integer,",
				"          RECEIPT_TYPE as short,",
				"          RELIGION as integer,",
				"          RO_LINK_ID as integer,",
				"          SEX as short,",
				"          SOCIAL_SECURITY_NO as string,",
				"          SOLICITOR_FLAG as short,",
				"          SPOUSE_ID as integer,",
				"          SUBSIDIARIES as integer,",
				"          SUFFIX_1 as integer,",
				"          SUFFIX_2 as integer,",
				"          TARGET as integer,",
				"          TITLE_1 as integer,",
				"          TITLE_2 as integer,",
				"          ACADEMY_ID as integer,",
				"          IS_CONSTITUENT as short,",
				"          FULL_NAME as string,",
				"          SYNCHRONIZE_FULLNAME as short,",
				"          INACTIVE as short,",
				"          NO_VALID_ADDRESSES as short,",
				"          ANONYMOUS as short,",
				"          PRIMARY_SALUTATION as string,",
				"          PRIMARY_ADDRESSEE as string,",
				"          PRIMARY_ADDRESSEE_EDIT as short,",
				"          PRIMARY_SALUTATION_EDIT as short,",
				"          AnnotationText as string,",
				"          AnnotationAutoDisplay as short,",
				"          PARENT_CORP_ID as integer,",
				"          DECEASED as short,",
				"          SOLICITOR_INACTIVE as short,",
				"          ConstituentPaysTax as short,",
				"          DeclarationMade as timestamp,",
				"          ConfirmationSent as timestamp,",
				"          ConfirmationReturned as timestamp,",
				"          TaxNotes as string,",
				"          NO_EMAIL as short,",
				"          DeclarationEnds as timestamp,",
				"          DeclarationStarts as timestamp,",
				"          TAX_PAYER_STATUS as integer,",
				"          DeclarationIndicator as integer,",
				"          ACADEMY_DATE_LAST_CHANGED as timestamp,",
				"          ACADEMY_LAST_CHANGED_BY as integer,",
				"          INTEGRATION_ID as integer,",
				"          INTEGRATION_DATE_LAST_CHANGED as timestamp,",
				"          AP7VENDORSID as integer,",
				"          INTEGRATION_HASH as string,",
				"          DECLARATIONSOURCE as integer,",
				"          GIVING_SCORE_OVERRIDE as integer,",
				"          USE_BB_GIVING_SCORE as short,",
				"          GIVING_SCORE_OVERRIDE_DATE as timestamp,",
				"          Gender as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> rerecords",
				"source(output(",
				"          ADDED_BY as integer,",
				"          AMOUNT_ASKED as decimal(30,6),",
				"          AMOUNT_EXPECTED as decimal(30,6),",
				"          AMOUNT_FUNDED as decimal(30,6),",
				"          CAMPAIGN as integer,",
				"          DATE_ADDED as timestamp,",
				"          DATE_ASKED as timestamp,",
				"          DATE_EXPECTED as timestamp,",
				"          DATE_FUNDED as timestamp,",
				"          DATE_LAST_CHANGED as timestamp,",
				"          DATE_RATED as timestamp,",
				"          DEADLINE as timestamp,",
				"          FUND as integer,",
				"          GIFT_TYPE as integer,",
				"          ID as integer,",
				"          IMPORT_ID as string,",
				"          INSTRUMENT as integer,",
				"          LAST_CHANGED_BY as integer,",
				"          PURPOSE as integer,",
				"          RATING as integer,",
				"          SEQUENCE as short,",
				"          STATUS as integer,",
				"          Proposal_Name as string,",
				"          PROSPECT_ID as integer,",
				"          INACTIVE as short,",
				"          REASON as integer,",
				"          ORIGINAL_AMOUNT_ASKED as decimal(30,6),",
				"          ORIGINAL_DATE_ASKED as timestamp,",
				"          NOTES as string,",
				"          CONTACTID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> reproposal",
				"source(output(",
				"          BOOLEAN as short,",
				"          COMMENTS as string,",
				"          CURR as decimal(30,6),",
				"          DATE_TIME as timestamp,",
				"          DTE as timestamp,",
				"          ID as integer,",
				"          IMPORT_ID as string,",
				"          NUM as integer,",
				"          SEQUENCE as short,",
				"          SOURCE as integer,",
				"          CATEGORY_ID as integer,",
				"          CATEGORY_CODE as integer,",
				"          TEXT as string,",
				"          STATICENTRY as integer,",
				"          PROSPECT_ID as integer,",
				"          ADDED_BY as integer,",
				"          DATE_ADDED as timestamp,",
				"          LAST_CHANGED_BY as integer,",
				"          DATE_LAST_CHANGED as timestamp,",
				"          TABLEENTRY as integer,",
				"          VERSION as integer,",
				"          SCORE_COMMITMENT as integer,",
				"          SCORE_ABILITY as integer,",
				"          WealthFinderHash as string,",
				"          WealthFinderPartialHash as string,",
				"          GIVING_SCORE_RUN as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> reratings",
				"source(output(",
				"          Source as string,",
				"          SourceId as integer,",
				"          GoldenRank as integer,",
				"          GRId as integer,",
				"          OriginalSource as string,",
				"          GiftAidOriginalSource as string,",
				"          OriginalCreationDate as timestamp,",
				"          LastChangeDate as timestamp,",
				"          CreationDate as timestamp,",
				"          CreationSource as string,",
				"          UpdateDate as timestamp,",
				"          UpdateSource as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> resepdate",
				"source(output(",
				"          TABLEENTRIESID as integer,",
				"          ACTIVE as short,",
				"          LONGDESCRIPTION as string,",
				"          SHORTDESCRIPTION as string,",
				"          SYSTEMENTRY as short,",
				"          PHONETYPE as short,",
				"          PHONEFORMAT as short,",
				"          SEQUENCE as integer,",
				"          CODETABLESID as integer,",
				"          DATEADDED as timestamp,",
				"          DATECHANGED as timestamp,",
				"          ADDEDBYID as integer,",
				"          LASTCHANGEDBYID as integer,",
				"          NUMERICVALUE as decimal(20,4),",
				"          AWARDAMOUNT as integer,",
				"          AWARDAMTUNITS as short,",
				"          MerchantNumber as string,",
				"          ADDED_BY_ID as integer,",
				"          LAST_CHANGED_BY_ID as integer,",
				"          UKSPECIFIC as short,",
				"          MEMSPECIFIC as short,",
				"          TableNumber as integer,",
				"          RatingsDataType as short,",
				"          PHONETYPENOTSHAREABLE as short,",
				"          INTEGRATION_ID as integer,",
				"          INTEGRATION_DATE_LAST_CHANGED as timestamp,",
				"          PGSpecific as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> retableentries",
				"source(output(",
				"          NotesId as integer,",
				"          NoteTypeId as integer,",
				"          NotepadDate as string,",
				"          Title as string,",
				"          Description as string,",
				"          Author as string,",
				"          Notes as binary,",
				"          ActualNotes as string,",
				"          Sequence as short,",
				"          ParentId as integer,",
				"          Import_Id as string,",
				"          DateAdded as date,",
				"          AddedById as integer,",
				"          DateChanged as timestamp,",
				"          LastChangedById as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> reConstituentNotepad3",
				"source(output(",
				"          ID as integer,",
				"          CONSTIT_ID as integer,",
				"          CLASSIFICATION as integer,",
				"          STATUS as integer,",
				"          BEING_DELETED as short,",
				"          RESEARCHPOINTURL as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> rePROSPECT3",
				"rerecords filter(KEY_INDICATOR == 'O' && INACTIVE == 0) ~> filter1",
				"filter1 select(mapColumn(",
				"          OrgName = ORG_NAME,",
				"          RECID = ID,",
				"          IMPORT_ID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"reproposal select(mapColumn(",
				"          ProspectID = ID,",
				"          PROSPECT_ID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectproposal",
				"reratings select(mapColumn(",
				"          CATEGORY_CODE,",
				"          PROSPECT_ID,",
				"          TABLEENTRY",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectratings",
				"filter2 select(mapColumn(",
				"          Grid = GRId,",
				"          SourceId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectsepdata",
				"resepdate filter(OriginalSource == 'RE') ~> filter2",
				"retableentries select(mapColumn(",
				"          TABLEENTRIESID,",
				"          LONGDESCRIPTION",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selecttableentries",
				"reConstituentNotepad3 select(mapColumn(",
				"          ActualNotes,",
				"          ParentId,",
				"          DateAdded",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 window(over(ParentId),",
				"     asc(DateAdded, true),",
				"     rowno = rowNumber()) ~> window1",
				"window1 select(mapColumn(",
				"          ActualNotes,",
				"          ParentId,",
				"          DateAdded,",
				"          rowno",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"select5 pivot(groupBy(ParentId),",
				"     pivotBy(rowno, [1, 2, 3, 4, 5]),",
				"     {Description_$} = first(ActualNotes),",
				"     columnNaming: '$N$V',",
				"     lateral: true) ~> pivot1",
				"pivot1 select(mapColumn(",
				"          ParentId,",
				"          {Description_$1},",
				"          {Description_$2},",
				"          {Description_$3},",
				"          {Description_$4},",
				"          {Description_$5}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectbiography",
				"selectbiography derive(AdditionalInformation = concatWS('\\n', {Description_$2})) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          ParentId,",
				"          {Description_$1},",
				"          AdditionalInformation",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectfinalbiography",
				"rePROSPECT3 select(mapColumn(",
				"          CONSTIT_ID,",
				"          STATUS,",
				"          Pr0spectID = ID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectprospect",
				"join6, selectprospect join(RECID == CONSTIT_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_ID,",
				"          CONSTIT_ID,",
				"          STATUS,",
				"          Pr0spectID,",
				"          Grid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"select6, selectproposal join(Pr0spectID == PROSPECT_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 select(mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_ID,",
				"          CONSTIT_ID,",
				"          STATUS,",
				"          Pr0spectID,",
				"          ProspectID,",
				"          PROSPECT_ID,",
				"          Grid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"select7, selectratings join(select7@PROSPECT_ID == selectratings@PROSPECT_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 select(mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_ID,",
				"          CATEGORY_CODE,",
				"          TABLEENTRY,",
				"          Grid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select8",
				"select8, selectfinalbiography join(RECID == ParentId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join4 select(mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_ID,",
				"          TABLEENTRY,",
				"          ParentId,",
				"          Biography = {Description_$1},",
				"          AdditionalInformation,",
				"          Grid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select9",
				"select9, selecttableentries join(TABLEENTRY == TABLEENTRIESID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join5",
				"join5 select(mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_ID,",
				"          TABLEENTRY,",
				"          Biography,",
				"          AdditionalInformation,",
				"          LONGDESCRIPTION,",
				"          Grid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select10",
				"select10 derive(CapacitytoDonate = case(",
				"    LONGDESCRIPTION == '1', '1 (10k-25k)',",
				"    LONGDESCRIPTION == '2', '2 (25k-50k)',",
				"    LONGDESCRIPTION == '3', '3 (50k-100k)',",
				"    LONGDESCRIPTION == '4', '4 (100k-250k)',",
				"    LONGDESCRIPTION == '5', '5 (250k-500k)',",
				"    LONGDESCRIPTION == '6', '6 (500k+)'",
				"),",
				"          LikelihoodtoDonate = case(",
				"    LONGDESCRIPTION == 'A', 'A (1 in 5)',",
				"    LONGDESCRIPTION == 'B', 'B (1 in 10)',",
				"    LONGDESCRIPTION == 'C', 'C (1 in 20)',",
				"    toString(null())",
				")) ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          OrgName,",
				"          RECID,",
				"          IMPORT_ID,",
				"          Biography,",
				"          AdditionalInformation,",
				"          CapacitytoDonate,",
				"          LikelihoodtoDonate,",
				"          Grid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select11",
				"select11 aggregate(groupBy(RECID,",
				"          Grid,",
				"          OrgName,",
				"          IMPORT_ID,",
				"          AdditionalInformation,",
				"          Biography),",
				"     CapacitytoDonate = max(CapacitytoDonate),",
				"          LikelihoodtoDonate = max(LikelihoodtoDonate)) ~> aggregate1",
				"select1, selectsepdata join(RECID == SourceId,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join6",
				"aggregate1 select(mapColumn(",
				"          RECID,",
				"          Grid,",
				"          OrgName,",
				"          IMPORT_ID,",
				"          AdditionalInformation,",
				"          Biography,",
				"          CapacitytoDonate,",
				"          LikelihoodtoDonate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select12",
				"select12 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sfprospectorg"
			]
		}
	}
}